# Configuración de PRODUCCIÓN de Presencard (la lee scripts/build-release.sh).
# NO la subas al servidor ni la compartas: contiene contraseñas. Permisos 600.

# Base de datos (cPanel > Bases de datos MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pafarnet_presencard
DB_USER=pafarnet_presencard_user
DB_PASSWORD=CAMBIAR
# Versión del servidor tal como la muestra phpMyAdmin (MariaDB 10.11.19)
DB_SERVER_VERSION=mariadb-10.11.19

# URL pública definitiva (de aquí salen los enlaces compartidos, los QR y la vista previa de WhatsApp)
PUBLIC_URL=https://pafar.net/presencard
# Ruta de la cookie de sesión: la misma subcarpeta, para no mezclarse con el sitio principal
COOKIE_PATH=/presencard

# Primer administrador (se crea con el SQL). La contraseña temporal se cambia al entrar.
ADMIN_EMAIL=admin@pafar.net
ADMIN_NAME=Administrador
ADMIN_TEMP_PASSWORD=CAMBIAR

# Secreto de Symfony (firma de tokens internos). Generado una vez; no lo cambies sin motivo.
APP_SECRET=CAMBIAR

# Clave de la página temporal diagnostico.php
DIAG_KEY=CAMBIAR
